# Sao chép file này thành .env.local (local) và điền giá trị thật.
# KHÔNG commit .env.local hay bất kỳ .env* nào khác ngoài file mẫu này.
# Diễn giải từng biến: xem docs/ARCHITECTURE.md mục 10.

# --- Chung ---
APP_ENV=
APP_URL=

# --- Database (Supabase Postgres qua Drizzle) ---
DATABASE_URL=
DATABASE_MIGRATION_URL=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- SePay ---
SEPAY_WEBHOOK_SECRET=
SEPAY_API_TOKEN=

# --- Tài khoản nhận tiền (chỉ đổi qua env + redeploy, không sửa qua admin) ---
PAYEE_BANK_BIN=
PAYEE_BANK_NAME=
PAYEE_ACCOUNT_NO=
PAYEE_ACCOUNT_NAME=

# --- Chọn adapter (Switchboard) ---
PAYMENT_PROVIDER=
SMS_PROVIDER=
CAPTCHA_PROVIDER=
STORAGE_PROVIDER=

# --- SMS / Supabase Send SMS Hook ---
SMS_HOOK_SECRET=

# --- CAPTCHA (Cloudflare Turnstile) ---
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Bàn giao đơn hàng và view token của khách vãng lai ---
HANDOVER_SECRET=
VIEW_TOKEN_PEPPER=

# --- Cron ---
CRON_SECRET=

# --- Theo dõi lỗi (Sentry) ---
SENTRY_DSN=

# --- Cảnh báo cho chủ shop (tùy chọn) ---
# Tên biến cụ thể tùy kênh đã chọn (Telegram/Zalo/email — xem docs/README.md Q12),
# thêm khi triển khai notifier tương ứng.
OWNER_ALERT_CHANNEL=
